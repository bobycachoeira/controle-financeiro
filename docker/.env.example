# Copie para docker/.env e preencha. Não versionar o .env real.
#   cp docker/.env.example docker/.env

# Host público (DuckDNS/nip.io para testar, ou seu domínio depois).
# Ex.: minhafamilia.duckdns.org  |  1.2.3.4.nip.io  |  app.seudominio.com
CF_DOMAIN=minhafamilia.duckdns.org

# URL pública do app (mesmo host com https://). Usada no Magic Link.
CF_APP_URL=https://minhafamilia.duckdns.org

# Chave de 32+ bytes para AES-GCM do segredo 2FA. Gere com:
#   openssl rand -base64 32
# NÃO troque depois de ativar o 2FA.
CF_ENCRYPTION_KEY=

# Validade do token de step-up (ex.: 10m, 15m).
CF_STEPUP_TTL=10m

# Fuso de negócio.
CF_TIMEZONE=America/Sao_Paulo

# --- SMTP (envio do Magic Link) ---
# Sem isto, o link só aparece no log do PocketBase (bom só para dev).
CF_MAIL_HOST=
CF_MAIL_PORT=587
CF_MAIL_USER=
CF_MAIL_PASSWORD=
CF_MAIL_FROM=no-reply@seudominio.com

# --- Notificações push (opcional) ---
# Gere com: pnpm --filter @cf/notifier vapid:generate
CF_VAPID_PUBLIC_KEY=
CF_VAPID_PRIVATE_KEY=
CF_VAPID_SUBJECT=mailto:no-reply@seudominio.com

# --- Superusuário do PocketBase (usado pelo deploy.sh, opcional) ---
CF_POCKETBASE_ADMIN_EMAIL=admin@seudominio.com
CF_POCKETBASE_ADMIN_PASSWORD=
