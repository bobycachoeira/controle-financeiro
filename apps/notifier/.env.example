CF_POCKETBASE_URL=http://127.0.0.1:8090
CF_POCKETBASE_ADMIN_EMAIL=admin@example.com
CF_POCKETBASE_ADMIN_PASSWORD=change-me

# Par de chaves VAPID (gere com: pnpm --filter @cf/notifier vapid:generate)
CF_VAPID_PUBLIC_KEY=
CF_VAPID_PRIVATE_KEY=
CF_VAPID_SUBJECT=mailto:admin@controle-financeiro.local

# Expressão cron e fuso de negócio
CF_NOTIFIER_CRON=0 * * * *
CF_TIMEZONE=America/Sao_Paulo
