# Chave de 32+ bytes usada para AES-GCM do segredo 2FA e assinatura do step-up.
CF_ENCRYPTION_KEY=dev-insecure-encryption-key-change-me

# SMTP/API de e-mail para Magic Link (opcional em dev; sem host o link é logado).
CF_MAIL_HOST=
CF_MAIL_PORT=587
CF_MAIL_USER=
CF_MAIL_PASSWORD=
CF_MAIL_FROM=no-reply@controle-financeiro.local

# Allowlist de CORS do frontend.
CF_CORS_ORIGINS=http://localhost:5173

# Validade do token de step-up (ex.: 10m, 15m).
CF_STEPUP_TTL=10m

# URL pública do app para montar o link mágico.
CF_APP_URL=http://localhost:5173
